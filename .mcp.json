{
  "mcpServers": {
    "billboardbug": {
      "command": "node",
      "args": [
        "build/index.js"
      ],
      "env": {
        "BILLBOARDBUG_API_BASE": "https://east-us-api.billboardbug.com",
        "BILLBOARDBUG_API_KEY": "${BILLBOARDBUG_API_KEY}"
      }
    },
    "ruvnet": {
      "type": "http",
      "url": "https://x.ruv.io/mcp"
    },
    "cognitum": {
      "type": "sse",
      "url": "https://cognitum.one/mcpSse"
    }
  }
}
